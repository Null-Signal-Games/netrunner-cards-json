{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.json",
    "**/*.json5",
    "**/*.jsonc",
    "**/*.markdown",
    "**/*.md",
    "**/*.yaml",
    "**/*.yml",
    "coverage/**",
    "dist/**"
  ],
  "printWidth": 100,
  "singleQuote": true,
  "tabWidth": 4,
  "trailingComma": "none",
  "useTabs": true
}
