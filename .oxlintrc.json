{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["coverage/**", "dist/**"],
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc"]
}
