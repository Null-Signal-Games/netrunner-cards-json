{
  "name": "@project-nisei/netrunner-cards-json",
  "version": "1.0.2",
  "type": "module",
  "description": "Card data for the Android: Netrunner card game.",
  "repository": "https://github.com/NetrunnerDB/netrunner-cards-json",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "translation-summary": "tsc && node dist/translation-summary.js",
    "format": "oxfmt && prettier --no-color --write '{{**,.}/*.json,.*.json,*.json}'",
    "format-check": "oxfmt --check && prettier --no-color --check '{{**,.}/*.json,.*.json,*.json}'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "tsc && vitest run",
    "coverage": "vitest run --coverage",
    "update-locales": "tsc && node dist/update-locales.js && node dist/update-locales-v2.js",
    "watch": "vitest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8",
    "command-line-args": "^6",
    "lodash": "^4",
    "prettier": "^3",
    "sync-fetch": "0.7"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1",
    "@types/lodash": "^4",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5",
    "husky": "^9",
    "lint-staged": "^17",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "prettier": "^3",
    "prettier-plugin-sort-json": "^4",
    "text-diff": "^1",
    "typescript": "^7.0.2",
    "vitest": "^5"
  },
  "lint-staged": {
    "*.{cjs,cts,js,mjs,mts,ts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "{{**,.}/*.json,.*.json,*.json}": "prettier --write"
  },
  "prettier": {
    "jsonRecursiveSort": true,
    "plugins": [
      "prettier-plugin-sort-json"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
